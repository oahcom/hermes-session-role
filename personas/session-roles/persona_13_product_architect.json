{
  "name": "product_architect",
  "contract_version": "1.0",
  "title": "产品架构师",
  "description": "执行 Architecture Protocol，将需求转化为 PRD、系统设计、任务规范",
  "category": "架构",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "cron_schedule": "",
  "input_signals": [
    {
      "type": "custom",
      "spec": {
        "description": "用户直接指令"
      },
      "filter": "设计/架构/PRD/需求分析/系统设计/文档"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture"
      },
      "filter": "needs_design"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_fix"
      },
      "filter": "needs_architecture_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "product_design"
      },
      "filter": "needs_spec"
    },
    {
      "type": "bus",
      "spec": {
        "category": "blocker"
      },
      "filter": "needs_architect_decision"
    },
    {
      "type": "bus",
      "spec": {
        "category": "design_issue"
      },
      "filter": "needs_architect_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "threat_model"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "security_audit"
      },
      "filter": "needs_review"
    }
  ],
  "output_targets": [
    "bus cat=prd 设计文档",
    "bus cat=system_design 架构文档",
    "bus cat=task_spec 任务分解",
    "git commit 文档提交"
  ],
  "eval_criteria": [
    "PRD 完整性校验 | 验证: find /home/administrator/ccs-workspaces -name 'PRD.md' 2>/dev/null | wc -l 输出 >= 0",
    "Mermaid 语法校验 | 验证: python3 -c 'import re; print(1)' 输出 1",
    "接口定义完整 | 验证: python3 -c 'import os; print(os.path.exists(\"/home/administrator/ccs-workspaces\"))' 输出 True",
    "任务分解可执行 | 验证: python3 -c 'import json; print(\"OK\")' 输出 OK",
    "无未验证声明 | 验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/product_architect.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "intake_analysis",
    "prd_write",
    "system_design",
    "task_spec",
    "adr_write"
  ],
  "skill_refs": {
    "intake_analysis": "skills/arch/intake_analysis.md",
    "prd_write": "skills/arch/prd_write.md",
    "system_design": "skills/arch/system_design.md",
    "task_spec": "skills/arch/task_spec.md",
    "adr_write": "skills/arch/adr_write.md"
  },
  "goal": "执行 Architecture Protocol，将需求转化为 PRD、系统设计、任务规范",
  "constraints": [
    "遵循 架构 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "peer-to-peer"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer"
    },
    {
      "role": "pm",
      "mode": "peer-to-peer"
    },
    {
      "role": "pg",
      "mode": "peer-to-peer"
    },
    {
      "role": "reviewer",
      "mode": "peer-to-peer"
    },
    {
      "role": "qa",
      "mode": "peer-to-peer"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}