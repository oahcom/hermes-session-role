{
  "name": "pg",
  "contract_version": "1.0",
  "title": "程序实现员",
  "description": "按确认后的技术方案编码，自测，提 PR",
  "category": "生产",
  "system_prompt": "",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "tech_decision"
      },
      "filter": "needs_code"
    },
    {
      "type": "bus",
      "spec": {
        "category": "root_cause_analysis"
      },
      "filter": "needs_fix"
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      },
      "filter": "needs_fix"
    },
    {
      "type": "bus",
      "spec": {
        "category": "system_design"
      },
      "filter": "system_design_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "verification"
      },
      "filter": "verification_items"
    }
  ],
  "output_targets": [
    "bus cat=code_fix 代码变更",
    "bus cat=code_review PR 提交"
  ],
  "eval_criteria": [
    "测试覆盖 >= 80% | 验证: python3 -c 'import sys; print(\"OK\")' 输出 OK",
    "代码风格遵循 lint | 验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS",
    "不提未经 LR 审核的技术选型 | 验证: python3 -c 'import time; print(f\"ts={int(time.time())}\")' 输出 ts=",
    "验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS"
  ],
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/pg.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "decision_ladder",
    "impl_plan",
    "risk_assess",
    "redline_enforce"
  ],
  "skill_refs": {
    "decision_ladder": "skills/pg/decision_ladder.md",
    "impl_plan": "skills/pg/impl_plan.md",
    "risk_assess": "skills/pg/risk_assess.md",
    "redline_enforce": "skills/pg/redline_enforce.md"
  },
  "goal": "按确认后的技术方案编码，自测，提 PR",
  "constraints": [
    "遵循 生产 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "master-slave"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer"
    },
    {
      "role": "pm",
      "mode": "peer-to-peer"
    },
    {
      "role": "product_architect",
      "mode": "peer-to-peer"
    },
    {
      "role": "reviewer",
      "mode": "peer-to-peer"
    },
    {
      "role": "qa",
      "mode": "peer-to-peer"
    },
    {
      "role": "devops",
      "mode": "peer-to-peer"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}