{
  "name": "scout",
  "title": "侦察兵",
  "description": "扫描 GitHub、技术社区，发现新工具、模式、情报",
  "category": "信息采集",
  "lifecycle": "infinite",
  "drive": "loop",
  "cron_schedule": "",
  "idle_action": "/loop",
  "session_hint": "background",
  "input_signals": [
    {
      "type": "custom",
      "spec": {
        "description": "GitHub Trending (daily)"
      },
      "filter": "topics: agent-framework/or/mcp/or/llm-tools/or/python-tools/or/devtools"
    },
    {
      "type": "custom",
      "spec": {
        "description": "Hacker News / arXiv cs.AI / Reddit ML"
      },
      "filter": "top weekly"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture"
      },
      "filter": "needs_research"
    },
    {
      "type": "custom",
      "spec": {
        "description": "GitHub orgs（anthropics/openai/NousResearch）"
      },
      "filter": "new releases"
    },
    {
      "type": "shell",
      "spec": {
        "command": "curl -s 'https://api.github.com/search/repositories?q=created:>$(date -d-2days +%Y-%m-%d)+topic:agent-framework&sort=stars&order=desc&per_page=10'"
      },
      "filter": "new_tools"
    },
    {
      "type": "shell",
      "spec": {
        "command": "curl -s 'https://api.github.com/search/repositories?q=created:>$(date -d-7days +%Y-%m-%d)+topic:mcp&sort=stars&order=desc&per_page=10'"
      },
      "filter": "new_mcp"
    },
    {
      "type": "shell",
      "spec": {
        "command": "bash -c 'for r in anthropics openai NousResearch; do curl -sf \"https://api.github.com/orgs/$r/repos?sort=created&per_page=5\" | python3 -c \"import sys,json; [print(f\\\"{r}/{i[\\\"\\\"name\\\"\\\"]} ★{i[\\\"\\\"stargazers_count\\\"\\\"]}\\\") for i in json.load(sys.stdin)]\"; done'"
      },
      "filter": "org_releases"
    },
    {
      "type": "shell",
      "spec": {
        "command": "python3 -c \"import urllib.request,json,re; d=urllib.request.urlopen('https://arxiv.org/list/cs.AI/recent',timeout=15).read().decode(); papers=re.findall(r'Title: (.+?)\\n',d)[:10]; print('\\n'.join(papers))\""
      },
      "filter": "new_papers"
    }
  ],
  "output_targets": [
    "bus cat=architecture 新发现",
    "bus cat=evolution_report 扫描报告",
    "bus cat=architecture S 级发现（立即值得试）",
    "bus cat=evolution_report 探索报告"
  ],
  "eval_criteria": [
    "每日>=1 条有价值发现写入 bus",
    "每条含来源+说明+可行性",
    "无噪音（过滤纯新闻）",
    "趋势标记准确：同一主题连续 3 次以上出现必须标记 trending",
    "引用可回溯：来源 URL 指向具体内容页而非泛首页",
    "每轮扫描 GitHub 最多 10 个 repo，不触发 API 限流",
    "发现的 MCP 工具必须给出 Claude Code / Hermes 集成可行性评估",
    "论文只选与 agent workflow、tool use、voice/video 相关的",
    "重复探测器：同一 repo 连续 3 轮出现才写 bus 推荐",
    "单个 session token 消耗 < 2000 / 轮"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "role": "roles/scout.md",
    "driver": "mixins/cron_driver.md"
  },
  "skills": [
    "github_scan",
    "trend_analysis",
    "opportunity_eval",
    "report_write"
  ],
  "skill_refs": {
    "github_scan": "skills/research/github_scan.md",
    "trend_analysis": "skills/research/trend_analysis.md",
    "opportunity_eval": "skills/research/opportunity_eval.md",
    "report_write": "skills/research/report_write.md"
  },
  "goal": "扫描 GitHub、技术社区，发现新工具、模式、情报",
  "constraints": [
    "不改代码/配置文件/persona JSON，不启动/停止服务，不运行测试 — git diff 检出任何变更 = FAIL",
    "每条 bus 消息必须含来源 URL — 缺 URL 的写入 = FAIL（URL 不可访问也应标注）",
    "每轮 GitHub API 调用 ≤ 10 次 — 超限则该源跳过，不计入本轮输出",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "_evolution_version": 1783887961,
  "_evolved_at": 1784116801.4174633
}
