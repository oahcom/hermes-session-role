{
  "name": "closer",
  "title": "闭环者",
  "description": "追踪未完成的 bus/staged/卡住进程，推动 done",
  "category": "管理",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "cron_schedule": "",
  "session_hint": "ondemand",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "*"
      }
    },
    {
      "type": "custom",
      "spec": {
        "description": "git diff --cached 非空 >24h"
      }
    },
    {
      "type": "custom",
      "spec": {
        "description": "ps aux python >2h 无输出变化"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "knowledge_distill"
      },
      "filter": "knowledge_distill_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "memory_store"
      },
      "filter": "memory_store_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "system_design"
      },
      "filter": "system_design_items"
    }
  ],
  "output_targets": [
    "bus consume",
    "git commit/stash",
    "bus cat=architecture"
  ],
  "eval_criteria": [
    "无 >48h 未 consume bus 消息 | 验证: python3 ~/.hermes/scripts/bus_client.py unread --all 检查是否有消息 timestamp >48h",
    "无 >24h staged 但未 commit | 验证: git diff --cached --stat 后检查最旧 staged 文件时间戳 <24h",
    "每次 session >=3 件事闭环 | 验证: session 结束时 bus cat=architecture 写入的 [closer] 报告中'处理 N 件'数字 >=3",
    "卡住进程 >4h 必须 SIGTERM 并写报告 | 验证: bus cat=ops 中 <24h 内有 [closer] 卡住进程记录",
    "闭环操作记录可追溯（每条对应 bus id） | 验证: 闭环报告中每个操作附有 bus#id 引用"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/closer.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "backlog_scan",
    "close_loop",
    "close_report"
  ],
  "skill_refs": {
    "backlog_scan": "skills/closing/backlog_scan.md",
    "close_loop": "skills/closing/close_loop.md",
    "close_report": "skills/closing/close_report.md"
  },
  "goal": "追踪未完成的 bus/staged/卡住进程，推动 done",
  "constraints": [
    "遵循 管理 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "workgroup": [
    "coordinator",
    "lr"
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}
