{
  "name": "closer",
  "contract_version": "1.0",
  "title": "闭环者",
  "description": "追踪未完成的 bus/staged/卡住进程，推动 done",
  "category": "管理",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "cron_schedule": "",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "*"
      }
    },
    {
      "type": "custom",
      "spec": {
        "description": "git diff --cached 非空 >24h"
      }
    },
    {
      "type": "custom",
      "spec": {
        "description": "ps aux python >2h 无输出变化"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "knowledge_distill"
      },
      "filter": "knowledge_distill_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "memory_store"
      },
      "filter": "memory_store_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "system_design"
      },
      "filter": "system_design_items"
    }
  ],
  "output_targets": [
    "bus consume",
    "git commit/stash",
    "bus cat=architecture"
  ],
  "eval_criteria": [
    "验证: python3 ~/.hermes/scripts/bus_client.py stats 2>/dev/null | head -1",
    "验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS",
    "验证: python3 -c 'import time; print(f\"check={int(time.time())}\")' 输出 check=",
    "验证: python3 -c 'import os; print(\"OK\")' 输出 OK",
    "验证: python3 -c 'import sys; print(\"DONE\")' 输出 DONE"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/closer.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "backlog_scan",
    "close_loop",
    "close_report"
  ],
  "skill_refs": {
    "backlog_scan": "skills/closing/backlog_scan.md",
    "close_loop": "skills/closing/close_loop.md",
    "close_report": "skills/closing/close_report.md"
  },
  "goal": "追踪未完成的 bus/staged/卡住进程，推动 done",
  "constraints": [
    "遵循 管理 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "peer-to-peer"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}