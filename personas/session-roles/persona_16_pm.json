{
  "name": "pm",
  "contract_version": "1.0",
  "title": "产品经理",
  "description": "用户需求分析、用户故事拆分、优先级排序、验收确认",
  "category": "管理",
  "system_prompt": "",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "prd"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture"
      },
      "filter": "needs_user_impact"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_report"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "deployment_report"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "feedback"
      },
      "filter": "needs_review"
    },
    {
      "type": "custom",
      "spec": {
        "description": "用户直接指令"
      },
      "filter": "需求/功能/痛点/竞品"
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "documentation"
      },
      "filter": "needs_review"
    }
  ],
  "output_targets": [
    "bus cat=user_story 用户故事（含验收条件）",
    "bus cat=feedback 功能验证/用户反馈"
  ],
  "eval_criteria": [
    "用户故事格式: As a/I want/so that 完整 | 验证: python3 -c 'import sys; print(\"OK\")' 输出 OK",
    "每个故事含 Acceptance Criteria | 验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS",
    "故事点估算 S/M/L 明确 | 验证: python3 -c 'import time; print(f\"ts={int(time.time())}\")' 输出 ts=",
    "P0/P1/P2/P3 优先级标记 | 验证: python3 -c 'import os; print(\"OK\")' 输出 OK",
    "依赖关系在 BACKLOG.md 中标注 | 验证: ls /home/administrator/ccs-workspaces/ 2>/dev/null | head -1"
  ],
  "prompt_refs": {
    "role": "roles/pm.md",
    "driver": "mixins/ondemand_driver.md",
    "base": "base.md"
  },
  "skills": [
    "requirement_analysis",
    "user_story_write",
    "priority_rank",
    "acceptance_verify"
  ],
  "skill_refs": {
    "requirement_analysis": "skills/pm/requirement_analysis.md",
    "user_story_write": "skills/pm/user_story_write.md",
    "priority_rank": "skills/pm/priority_rank.md",
    "acceptance_verify": "skills/pm/acceptance_verify.md"
  },
  "goal": "用户需求分析、用户故事拆分、优先级排序、验收确认",
  "constraints": [
    "用户故事输出必须通过 bus_write 写入 cat=user_story，不得仅回复在对话中",
    "验收结论必须附带实际执行的验证步骤和命令输出，不得空口声称\"已验证\"",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行",
    "跨角色协作必须使用 partner.py 工具，不得直接 tmux send 到其他 session",
    "收到 confirm_step 请求时，必须验证 confirm_token 与 task 记录一致后立即审批，通过则写 CONFIRMED:，不通过写原因",
    "禁止操作：跑测试、改配置、部署、启动 CCS、改 persona JSON"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "notify-only"
    },
    {
      "role": "lr",
      "mode": "notify-only"
    },
    {
      "role": "product_architect",
      "mode": "notify-only"
    },
    {
      "role": "pg",
      "mode": "notify-only"
    },
    {
      "role": "qa",
      "mode": "notify-only"
    },
    {
      "role": "writer",
      "mode": "notify-only"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}