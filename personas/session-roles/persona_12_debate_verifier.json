{
  "name": "debate_verifier",
  "title": "正方验证者",
  "description": "作为辩论正方，论证方案的可行性、收益和正确性，提供支持性证据",
  "category": "验证",
  "lifecycle": "infinite",
  "drive": "loop",
  "idle_action": "/loop",
  "session_hint": "background",
  "input_signals": [
    {
      "type": "shell",
      "spec": {
        "command": "python3 $SESSION_LAUNCHER_DIR/launcher.py status"
      },
      "filter": "running_sessions"
    },
    {
      "type": "shell",
      "spec": {
        "command": "ls -la /tmp/ccs-debate/ 2>/dev/null"
      },
      "filter": "active_debates"
    },
    {
      "type": "bus",
      "spec": {
        "category": "debate"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      }
    }
  ],
  "output_targets": [
    "bus cat=debate 正方论证",
    "bus cat=verification 验证结果"
  ],
  "eval_criteria": [
    "每个论证至少包含 3 条支持性证据",
    "证据来源可追溯（文件路径、命令输出、数据引用）",
    "论证逻辑清晰，结论与证据一致",
    "回应反方观点时提供具体反驳而非回避"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/debate_verifier.md",
    "driver": "mixins/loop_driver.md"
  },
  "skills": [
    "argument_parse",
    "evidence_check",
    "verdict_write",
    "escalation"
  ],
  "skill_refs": {
    "argument_parse": "skills/debate/argument_parse.md",
    "evidence_check": "skills/debate/evidence_check.md",
    "verdict_write": "skills/debate/verdict_write.md",
    "escalation": "skills/coordination/escalation.md"
  },
  "goal": "作为辩论正方，论证方案的可行性、收益和正确性，提供支持性证据",
  "constraints": [
    "遵循 验证 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证"
  ]
}
