{
  "name": "debate_verifier",
  "contract_version": "1.0",
  "title": "正方验证者",
  "description": "作为辩论正方，论证方案的可行性、收益和正确性，提供支持性证据",
  "category": "验证",
  "lifecycle": "infinite",
  "drive": "loop",
  "idle_action": "/loop",
  "input_signals": [
    {
      "type": "shell",
      "spec": {
        "command": "python3 $SESSION_LAUNCHER_DIR/launcher.py status"
      },
      "filter": "running_sessions"
    },
    {
      "type": "shell",
      "spec": {
        "command": "ls -la /tmp/ccs-debate/ 2>/dev/null"
      },
      "filter": "active_debates"
    },
    {
      "type": "bus",
      "spec": {
        "category": "debate"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      }
    }
  ],
  "output_targets": [
    "bus cat=debate 正方论证",
    "bus cat=verification 验证结果"
  ],
  "eval_criteria": [
    "每个论证至少包含 3 条支持性证据 | 验证: python3 -c 'import sys; print(\"OK\")' 输出 OK",
    "证据来源可追溯（文件路径、命令输出、数据引用） | 验证: ls /home/administrator/ccs-workspaces/ 2>/dev/null | head -1",
    "论证逻辑清晰，结论与证据一致 | 验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS",
    "回应反方观点时提供具体反驳而非回避 | 验证: python3 -c 'import time; print(f\"ts={int(time.time())}\")' 输出 ts="
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/debate_verifier.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "argument_parse",
    "evidence_check",
    "verdict_write",
    "escalation"
  ],
  "skill_refs": {
    "argument_parse": "skills/debate/argument_parse.md",
    "evidence_check": "skills/debate/evidence_check.md",
    "verdict_write": "skills/debate/verdict_write.md",
    "escalation": "skills/coordination/escalation.md"
  },
  "goal": "作为辩论正方，论证方案的可行性、收益和正确性，提供支持性证据",
  "constraints": [
    "遵循 验证 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "peer-to-peer"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer"
    },
    {
      "role": "pm",
      "mode": "peer-to-peer"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}