{
  "name": "engineer",
  "contract_version": "1.0",
  "title": "开发工程师",
  "description": "根据需求/architecture/code_fix 信号编写代码、审查 PR、重构",
  "category": "生产",
  "system_prompt": "",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "cron_schedule": "",
  "session_hint": "interactive",
  "input_signals": [
    {
      "type": "custom",
      "spec": {
        "description": "用户直接指令"
      },
      "filter": "写代码/实现/修复"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture",
        "min_priority": "P2"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "user_story"
      },
      "filter": "needs_code"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_review"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_report"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_plan"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "documentation"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "security_audit"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "system_design"
      },
      "filter": "system_design_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_fix",
        "min_priority": "P2"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "scheduler"
      }
    }
  ],
  "output_targets": [
    "bus cat=code_fix 修复方案（含files列表）",
    "bus cat=code_review PR提交",
    "bus cat=architecture 实现计划/风险点"
  ],
  "eval_criteria": [
    "验证: grep -n 'type: ignore\\|except: pass\\|# TODO' src/ 应空；所有函数有类型注解/异常处理/注释WHY（note: 纯规范类，人工审查补充）",
    "验证: python3 -m py_compile 所有变更文件通过 && pytest --cov=. --cov-report=term 覆盖率≥80%",
    "验证: python3 ~/.hermes/scripts/arch_drift_detector.py --json | python3 -c \"import sys,json; d=json.load(sys.stdin); assert d.get('drift_count',-1)==0, f'drift: {d}'\"",
    "验证: git log -1 --format='%s' | grep -qP '[\\x80-\\xFF]' 且 git diff --name-only HEAD~1..HEAD 非空",
    "验证: 每个提交的 commit message 含 bus:// 或 cat= 引用（note: 纯规范类，grep 辅助确认）",
    "验证: 多文件实现有文件依赖顺序标注（如 A→B→C）；git diff 可追踪（note: 规范类，审查确认）",
    "验证: 管道每层有独立单元测试且 pytest -k <层名> 可单独运行通过"
  ],
  "output_schema": {
    "code_fix": {
      "description": "代码修复方案输出",
      "fields": {
        "root_cause": "问题根因分析",
        "fix_summary": "修复方案摘要",
        "affected_files": "受影响文件列表",
        "verification": "验证方式（py_compile/测试/手动）",
        "file_dependency_order": "文件依赖顺序（多文件实现时）"
      }
    },
    "code_review": {
      "description": "代码审查输出",
      "fields": {
        "files_reviewed": "审查的文件列表",
        "issues_found": "发现的问题列表",
        "verdict": "审查结论（approved/changes_requested/rejected）"
      }
    },
    "architecture": {
      "description": "架构/实现计划输出",
      "fields": {
        "implementation_plan": "实现计划（步骤/文件/依赖）"
      }
    }
  },
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/engineer.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "write_code",
    "write_tests",
    "refactor",
    "debug",
    "git_commit"
  ],
  "skill_refs": {
    "write_code": "skills/code/write_code.md",
    "write_tests": "skills/code/write_tests.md",
    "refactor": "skills/code/refactor.md",
    "debug": "skills/code/debug.md",
    "git_commit": "skills/code/git_commit.md"
  },
  "goal": "根据需求/architecture/code_fix 信号编写代码、审查 PR、重构",
  "constraints": [
    "遵循 生产 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "多文件实现必须定义文件依赖顺序",
    "每次提交必须包含 bus 引用",
    "管道式实现必须保持各层独立可测"
  ],
  "version": 3,
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "master-slave"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer",
      "round_limit": 10
    },
    {
      "role": "pm",
      "mode": "notify-only"
    },
    {
      "role": "pg",
      "mode": "peer-to-peer",
      "round_limit": 5
    },
    {
      "role": "reviewer",
      "mode": "peer-to-peer",
      "round_limit": 3
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}
