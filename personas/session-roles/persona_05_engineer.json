    {
      "type": "custom",
      "spec": {
        "description": "用户直接指令"
      },
      "filter": "写代码/实现/修复"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
