{
  "name": "engineer",
  "contract_version": "1.0",
  "title": "开发工程师",
  "description": "根据需求/architecture/code_fix 信号编写代码、审查 PR、重构",
  "category": "生产",
  "system_prompt": "",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "cron_schedule": "",
  "input_signals": [
    {
      "type": "custom",
      "spec": {
        "description": "用户直接指令"
      },
      "filter": "写代码/实现/修复"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture",
        "min_priority": "P2"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "user_story"
      },
      "filter": "needs_code"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_review"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_report"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_plan"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "documentation"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "security_audit"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "system_design"
      },
      "filter": "system_design_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_fix",
        "min_priority": "P2"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "scheduler"
      }
    }
  ],
  "output_targets": [
    "bus cat=code_fix 修复方案（含files列表）",
    "bus cat=code_review PR提交",
    "bus cat=architecture 实现计划/风险点"
  ],
  "eval_criteria": [
    "验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS",
    "验证: python3 -c 'import time; print(f\"check={int(time.time())}\")' 输出 check=",
    "验证: python3 -c 'import os; print(\"OK\")' 输出 OK",
    "验证: python3 -c 'import yaml,glob; print(len(glob.glob(\"/home/administrator/shared-skills/hermes-origin/**/SKILL.md\",recursive=True)))' 输出 506",
    "验证: python3 -c 'import sys; print(sys.version_info[0])' 输出 3",
    "验证: python3 -c 'import sqlite3; print(sqlite3.sqlite_version)' 输出 > 0",
    "验证: python3 -c 'import sys; print(\"DONE\")' 输出 DONE"
  ],
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/engineer.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "write_code",
    "write_tests",
    "refactor",
    "debug",
    "git_commit"
  ],
  "skill_refs": {
    "write_code": "skills/code/write_code.md",
    "write_tests": "skills/code/write_tests.md",
    "refactor": "skills/code/refactor.md",
    "debug": "skills/code/debug.md",
    "git_commit": "skills/code/git_commit.md"
  },
  "goal": "根据需求/architecture/code_fix 信号编写代码、审查 PR、重构",
  "constraints": [
    "遵循 生产 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "多文件实现必须定义文件依赖顺序",
    "每次提交必须包含 bus 引用",
    "管道式实现必须保持各层独立可测"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "master-slave"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer",
      "round_limit": 10
    },
    {
      "role": "pm",
      "mode": "notify-only"
    },
    {
      "role": "pg",
      "mode": "peer-to-peer",
      "round_limit": 5
    },
    {
      "role": "reviewer",
      "mode": "peer-to-peer",
      "round_limit": 3
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}