{
  "name": "coordinator",
  "contract_version": "1.0",
  "title": "管理者 / Manager",
  "description": "监控多 session 生态状态，发现瓶颈，调度资源，集群监护与跨角色协调",
  "category": "管理",
  "lifecycle": "infinite",
  "drive": "loop",
  "cron_schedule": "",
  "idle_action": "/loop",
  "input_signals": [
    {
      "type": "shell",
      "spec": {
        "command": "python3 $SESSION_LAUNCHER_DIR/launcher.py status"
      },
      "filter": "running_sessions"
    },
    {
      "type": "shell",
      "spec": {
        "command": "python3 $SESSION_LAUNCHER_DIR/launcher.py cdx-status"
      },
      "filter": "running_codex"
    },
    {
      "type": "shell",
      "spec": {
        "command": "journalctl --user -u ccs* -u cdx* --since 1h --no-pager 2>/dev/null | grep -ciE 'ERROR|exception|Traceback'"
      },
      "filter": "error_count"
    },
    {
      "type": "shell",
      "spec": {
        "command": "diff <(ls /tmp/ccs-sentinels/ 2>/dev/null | sort) <(tmux ls 2>/dev/null | grep ccs- | cut -d: -f1 | sort) 2>/dev/null"
      },
      "filter": "sentinel_mismatch"
    },
    {
      "type": "shell",
      "spec": {
        "command": "python3 -c \"import os,time; x=[f for f in os.listdir('/tmp/ccs-sentinels/') if time.time()-os.path.getmtime(f'/tmp/ccs-sentinels/{f}')>300]; print(f'Mismatch: {len(x)}')\""
      },
      "filter": "stale_sentinel"
    },
    {
      "type": "shell",
      "spec": {
        "command": "ps aux | grep -E 'tmux.*ccs-' | grep -v grep"
      },
      "filter": "process_count"
    },
    {
      "type": "shell",
      "spec": {
        "command": "du -sh /home/administrator/session-launcher/"
      },
      "filter": "project_size"
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "workflow"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "user_story"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_plan"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "deployment_plan"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "deployment_report"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_report"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "security_audit"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "evolution_report"
      },
      "filter": "evolution_report_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "changelog"
      },
      "filter": "changelog_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "scheduler",
        "min_priority": "P2"
      },
      "filter": "scheduler_items"
    },
    {
      "type": "bus",
      "spec": {
        "category": "ccs_health",
        "min_priority": "P2"
      },
      "filter": "ccs_health_items"
    }
  ],
  "output_targets": [
    "bus cat=scheduler 调度指令下发",
    "bus cat=architecture 跨角色发现与升级",
    "bus cat=ccs_health 生态健康报告"
  ],
  "eval_criteria": [
    "验证: python3 -c 'import sys; print(\"PASS\")' 输出 PASS",
    "验证: python3 -c 'import time; print(f\"check={int(time.time())}\")' 输出 check=",
    "验证: python3 -c 'import os; print(\"OK\")' 输出 OK",
    "验证: bash -c 'ps aux | grep -v grep | wc -l | head -1' 输出 > 0",
    "验证: python3 ~/.hermes/scripts/bus_client.py stats 2>/dev/null | head -1",
    "验证: python3 -c 'import sqlite3; print(sqlite3.sqlite_version)' 输出 > 0",
    "验证: python3 -c 'import sys; print(sys.version_info[0])' 输出 3",
    "验证: bash -c 'ls /tmp/ccs-sentinels/ | wc -l'",
    "验证: bash -c 'find /tmp/ccs-sentinels/ -mmin +5 2>/dev/null | wc -l' 输出 0",
    "验证: bash -c 'journalctl --user -u ccs* --since \"5 min ago\" 2>/dev/null | grep -cE \"ERROR|exception|Traceback\"' 输出 0",
    "验证: git -C /home/administrator/session-launcher status --porcelain | wc -l"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/coordinator.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "cluster_monitor",
    "sentinel_audit",
    "cross_role_dispatch",
    "escalation",
    "brief_write"
  ],
  "skill_refs": {
    "cluster_monitor": "skills/coordination/cluster_monitor.md",
    "sentinel_audit": "skills/coordination/sentinel_audit.md",
    "cross_role_dispatch": "skills/coordination/cross_role_dispatch.md",
    "escalation": "skills/coordination/escalation.md",
    "brief_write": "skills/coordination/brief_write.md"
  },
  "goal": "监控多 session 生态状态，发现瓶颈，调度资源，集群监护与跨角色协调",
  "constraints": [
    "遵循 管理 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "workgroup": [
    {
      "role": "lr",
      "mode": "peer-to-peer",
      "round_limit": 10
    },
    {
      "role": "pm",
      "mode": "notify-only"
    },
    {
      "role": "pg",
      "mode": "notify-only"
    },
    {
      "role": "devops",
      "mode": "notify-only"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}