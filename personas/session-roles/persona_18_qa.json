{
  "name": "qa",
  "title": "测试工程师",
  "description": "测试计划、用例设计、自动化测试、回归验证、性能测试",
  "category": "质量",
  "system_prompt": "",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "session_hint": "interactive",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      },
      "filter": "needs_test",
      "source_role": "PM/PA",
      "description": "收到测试任务"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_fix"
      },
      "filter": "needs_test",
      "source_role": "PG",
      "description": "收到待验证的修复"
    },
    {
      "type": "bus",
      "spec": {
        "category": "prd"
      },
      "filter": "needs_test_plan",
      "source_role": "PM/PA",
      "description": "收到需规划测试的 PRD"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_plan"
      },
      "filter": "needs_review",
      "source_role": "QA",
      "description": "收到待评审的测试计划（来自其他 QA session）"
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      },
      "filter": "needs_triage",
      "source_role": "QA",
      "description": "收到待分类的缺陷报告（来自其他 QA session）"
    },
    {
      "type": "bus",
      "spec": {
        "category": "blocker"
      },
      "filter": "*",
      "source_role": "any",
      "description": "越界拒绝通知（仅读不处理）"
    }
  ],
  "output_targets": [
    "bus cat=test_plan → PM 测试计划（范围/策略/风险/级别）",
    "bus cat=test_report → PM 测试报告【执行摘要: 通过数/总数/通过率】【缺陷统计: P0-P3 分布】【风险评估: 高/中/低 + 依据】【建议: Go/No-Go】",
    "bus cat=bug_report → PG 缺陷报告【标题: [P0/P1/P2/P3] 模块名_缺陷简述】【复现步骤: 1）xxx 2）xxx 3）xxx】【期望结果】【实际结果】【环境: 操作系统/浏览器/版本】【严重度: P0(阻塞)/P1(严重)/P2(一般)/P3(建议)】",
    "bus cat=blocker → any 越界拒绝通知"
  ],
  "eval_criteria": [
    "测试计划含：范围/策略/人力/风险",
    "测试用例覆盖：正常/边界/错误/安全/性能",
    "测试报告格式：summary/defects/regression/perf",
    "缺陷等级分级: P0(阻塞)/P1(严重)/P2(一般)/P3(建议)",
    "P0 缺陷阻塞发布门禁",
    "所有产出必须通过 codex review --uncommitted -c model=gpt-4o --title \"测试验证\" 审查门禁再发布",
    "越界请求必须输出 bus cat=blocker 格式拒绝",
    "测试用例模板含8列: ID/模块/前置条件/操作步骤/预期结果/实际结果/严重级/风险类型"
  ],
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/qa.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "test_plan",
    "test_case_write",
    "test_execute",
    "test_report"
  ],
  "skill_refs": {
    "test_plan": "skills/qa/test_plan.md",
    "test_case_write": "skills/qa/test_case_write.md",
    "test_execute": "skills/qa/test_execute.md",
    "test_report": "skills/qa/test_report.md"
  },
  "goal": "测试计划、用例设计、自动化测试、回归验证、性能测试",
  "constraints": [
    "遵循 质量 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证",
    "收到含 task_id 的 ccs send 时，必须先调 check_task() 确认该 task 存在且状态合法再执行。无 task_id 的消息自由处理"
  ],
  "workgroup": [
    {
      "role": "coordinator",
      "mode": "master-slave"
    },
    {
      "role": "lr",
      "mode": "peer-to-peer"
    },
    {
      "role": "pm",
      "mode": "peer-to-peer"
    },
    {
      "role": "pg",
      "mode": "peer-to-peer"
    },
    {
      "role": "reviewer",
      "mode": "peer-to-peer"
    },
    {
      "role": "devops",
      "mode": "peer-to-peer"
    }
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}