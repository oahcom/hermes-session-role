  "input_signals": [
    {
      "type": "custom",
      "spec": {
        "description": "用户直接指令"
      },
      "filter": "写代码/实现/修复"
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "task_spec"
      },
      "filter": "needs_implementation"
    },
    {
      "type": "bus",
      "spec": {
        "category": "user_story"
      },
      "filter": "needs_code"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_review"
      },
      "filter": "needs_review"
    },
    {
      "type": "bus",
      "spec": {
        "category": "bug_report"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_report"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "test_plan"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "documentation"
      },
      "filter": "needs_work"
    },
    {
      "type": "bus",
      "spec": {
        "category": "security_audit"
      },
      "filter": "needs_work"
    }
  ],
  "output_targets": [
    "bus cat=code_fix 修复方案（含files列表）",
    "bus cat=code_review PR提交",
    "bus cat=architecture 实现计划/风险点"
  ],
  "eval_criteria": [
    "代码符合类型注解/异常处理/注释WHY",
    "py_compile 通过、测试覆盖≥80%",
    "arch_drift_detector 无漂移",
    "PR 提交时 git commit 中文描述、含变更文件列表"
  ],
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/engineer.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "write_code",
    "write_tests",
    "refactor",
    "debug",
    "git_commit"
  ],
  "skill_refs": {
    "write_code": "skills/code/write_code.md",
    "write_tests": "skills/code/write_tests.md",
    "refactor": "skills/code/refactor.md",
    "debug": "skills/code/debug.md",
    "git_commit": "skills/code/git_commit.md"
  },
  "goal": "根据需求/architecture/code_fix 信号编写代码、审查 PR、重构",
  "constraints": [
    "遵循 生产 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证"
  ]
}