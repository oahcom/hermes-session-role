{
  "name": "ccs-monitor",
  "title": "Session 监控者",
  "description": "监控所有 CCS tmux session 是否卡住/停滞，卡住了就发 Enter 让它继续",
  "category": "监控",
  "lifecycle": "infinite",
  "drive": "ondemand",
  "idle_action": "sleep 30",
  "session_hint": "loop",
  "input_signals": [
    {
      "type": "shell",
      "spec": {
        "command": "tmux ls 2>/dev/null | grep ccs- | cut -d: -f1"
      },
      "filter": "ccs_sessions"
    },
    {
      "type": "shell",
      "spec": {
        "command": "ls /tmp/ccs-sentinels/ 2>/dev/null"
      },
      "filter": "sentinels"
    },
    {
      "type": "shell",
      "spec": {
        "command": "for s in $(tmux ls 2>/dev/null | grep ccs- | cut -d: -f1); do echo \"=== $s ===\"; tmux capture-pane -t \"$s\" -p 2>/dev/null | tail -3; done"
      },
      "filter": "session_tail"
    },
    {
      "type": "shell",
      "spec": {
        "command": "ps aux | grep -E 'claude.*ccs-' | grep -v grep | head -20"
      },
      "filter": "ccs_processes"
    }
  ],
  "output_targets": [
    "bus cat=notice session 卡住通知"
  ],
  "eval_criteria": [
    "30秒内完成一轮check"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/ccs_monitor.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "ccs_health_check",
    "log_anomaly_detect",
    "alert_write"
  ],
  "skill_refs": {
    "ccs_health_check": "skills/monitor/ccs_health_check.md",
    "log_anomaly_detect": "skills/monitor/log_anomaly_detect.md",
    "alert_write": "skills/monitor/alert_write.md"
  },
  "goal": "监控所有 CCS tmux session 是否卡住/停滞，卡住了就发 Enter 让它继续",
  "constraints": [
    "遵循 监控 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证"
  ]
}
