{
  "name": "regression_test_return",
  "contract_version": "1.0",
  "title": "回归测试验收",
  "description": "回归测试结果验证、修复验收",
  "category": "质量",
  "lifecycle": "ondemand",
  "drive": "ondemand",
  "goal": "回归验证与验收",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "test_report"
      },
      "filter": "regression"
    },
    {
      "type": "bus",
      "spec": {
        "category": "code_fix"
      },
      "filter": "needs_regression_check"
    }
  ],
  "output_targets": [
    "bus cat=test_report 回归验收结论",
    "bus cat=blocker 回归阻塞通知"
  ],
  "constraints": [
    "遵循 质量 角色红线",
    "不做超出职责范围的事"
  ],
  "workgroup": [
    {
      "role": "qa",
      "mode": "peer-to-peer"
    }
  ],
  "system_prompt": "",
  "skills": [
    "testing",
    "reporting"
  ],
  "skill_refs": {
    "testing": "skills/qa/test_plan.md",
    "reporting": "skills/qa/test_report.md"
  },
  "prompt_refs": {
    "base": "base.md"
  },
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}
