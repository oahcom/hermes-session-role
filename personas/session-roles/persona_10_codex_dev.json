{
  "name": "codex-dev",
  "title": "Codex 开发者",
  "description": "Codex GOAL 模式驱动开发引擎 — 接收 architecture/code_fix 信号，写代码、测试、提交",
  "category": "开发",
  "lifecycle": "infinite",
  "drive": "goal",
  "cron_schedule": "",
  "session_hint": "background",
  "input_signals": [
    {
      "type": "bus",
      "spec": {
        "category": "code_fix"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "architecture"
      }
    },
    {
      "type": "bus",
      "spec": {
        "category": "optimization"
      }
    },
    {
      "type": "shell",
      "spec": {
        "command": "git -C /home/administrator/hermes-by-dkk diff --name-only 2>/dev/null"
      },
      "filter": "uncommitted"
    }
  ],
  "output_targets": [
    "bus cat=code_review",
    "git commit directly",
    "bus cat=code_fix"
  ],
  "eval_criteria": [
    "验收: 每轮处理 >= 1 个未处理的 bus 任务",
    "验收: 每轮产出可执行的代码变更",
    "验收: 每次提交包含测试或验证",
    "验收: 处理后更新 bus 状态为 done",
    "验收: Git commit 有清晰的中文描述"
  ],
  "system_prompt": "",
  "prompt_refs": {
    "base": "base.md",
    "role": "roles/codex_dev.md",
    "driver": "mixins/ondemand_driver.md"
  },
  "skills": [
    "goal_manage",
    "bus_poll",
    "code_write",
    "verify_commit",
    "budget_wrap"
  ],
  "skill_refs": {
    "goal_manage": "skills/codex/goal_manage.md",
    "bus_poll": "skills/codex/bus_poll.md",
    "code_write": "skills/codex/code_write.md",
    "verify_commit": "skills/codex/verify_commit.md",
    "budget_wrap": "skills/codex/budget_wrap.md"
  },
  "goal": "Codex GOAL 模式驱动开发引擎 — 接收 architecture/code_fix 信号，写代码、测试、提交",
  "constraints": [
    "遵循 开发 角色红线",
    "不做超出职责范围的事",
    "输出必须可验证"
  ],
  "workgroup": [
    "coordinator",
    "lr"
  ],
  "mcp_servers": [
    "hex-line"
  ],
  "mcp_tools": {
    "hex-line": [
      "read_file",
      "edit_file",
      "grep_search",
      "inspect_path"
    ]
  }
}
